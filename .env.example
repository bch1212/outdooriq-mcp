# Postgres connection — when set, OutdoorIQ runs in Postgres mode against the CastIQ dataset.
# Leave unset to force SQLite fallback (bundled seed data).
DATABASE_URL=postgresql://vikinetic:vikinetic_dev@localhost:5444/vikinetic

# Comma-separated extra Pro API keys (the dev key is always loaded).
# Format: key:plan  (plan = free|pro)
OUTDOORIQ_EXTRA_KEYS=

# Optional override for the dev/free key.
OUTDOORIQ_DEV_KEY=outdooriq-dev-key-001

# Free-plan daily call budget.
OUTDOORIQ_FREE_DAILY_LIMIT=50

PORT=8080
